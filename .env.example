# =============================================================================
# Placement Portal — Environment Variables Reference
# =============================================================================
# Copy this file to backend/.env and fill in the values for local development.
# On Render, set these in the Render dashboard Environment tab or via render.yaml
#
# DO NOT commit real secrets to git.
# =============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, or local postgres)
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
SQLALCHEMY_DATABASE_URI=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Random secret key for JWT signing. Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_long_random_secret_key

# ---------------------------------------------------------------------------
# CORS (Backend only)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS (development only).
# In production the frontend and backend are the SAME origin — CORS is not needed.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------------------------------------------------------------------------
# Frontend (local development only)
# ---------------------------------------------------------------------------
# Create frontend/.env.local with this variable for local dev.
# In production leave UNSET — the /api/v1 relative path is used automatically.
#
# File: frontend/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
